{
	"name": "guild-channel-binaries",
	"version": "1.0.7",
	"description": "BrickVerse Guild Channels desktop app",
	"main": "dist/main.js",
	"author": {
		"name": "Meta Games LLC",
		"email": "support@brickverse.gg"
	},
	"license": "Apache-2.0",
	"types": "dist/main.d.ts",
	"homepage": "https://github.com/BrickVerse-co/guild-channel-binaries#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BrickVerse-co/guild-channel-binaries.git"
	},
	"bugs": {
		"url": "https://github.com/BrickVerse-co/guild-channel-binaries/issues"
	},
	"scripts": {
		"build": "tsc",
		"start": "npm run build && electron .",
		"demo:presence-relay": "node scripts/demo-presence-relay.js",
		"dist": "npm run build && electron-builder --publish never",
		"dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
		"dist:mac": "npm run build && electron-builder --mac dmg zip --universal --publish never",
		"dist:linux": "npm run build && electron-builder --linux AppImage --x64 --arm64 --publish never",
		"release": "npm run build && electron-builder --publish always",
		"build:win:unsigned": "npm run build && electron-builder --win --publish never",
		"build:win": "npm run build:win:unsigned && npm run sign:win",
		"sign:win": "powershell -ExecutionPolicy Bypass -File .\\scripts\\sign-azure.ps1"
	},
	"build": {
		"appId": "gg.brickverse.guildchannels",
		"productName": "BrickVerseGuildChannels",
		"artifactName": "${productName}-${os}-${arch}.${ext}",
		"directories": {
			"buildResources": "assets",
			"output": "release"
		},
		"asarUnpack": [
			"assets/**"
		],
		"files": [
			"dist/**/*",
			"src/**/*",
			"package.json",
			"assets/**/*"
		],
		"extraResources": [
			"assets/**/*"
		],
		"mac": {
			"target": [
				"dmg",
				"zip"
			],
			"category": "public.app-category.social-networking"
		},
		"win": {
			"target": [
				"nsis"
			]
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"deleteAppDataOnUninstall": false
		},
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Network",
			"maintainer": "Meta Games LLC <support@brickverse.gg>"
		},
		"publish": [
			{
				"provider": "github",
				"owner": "BrickVerse-co",
				"repo": "guild-channel-binaries"
			}
		]
	},
	"dependencies": {
		"discord-rpc": "^4.0.1",
		"dotenv": "^17.4.2",
		"electron-updater": "^6.8.11"
	},
	"devDependencies": {
		"@types/discord-rpc": "^4.0.10",
		"dotenv-cli": "^11.0.0",
		"electron": "^45.1.0",
		"electron-builder": "^26.18.0",
		"typescript": "^5.9.3"
	}
}
